# AcademicIQ Backend Environment Variables
# Copy to .env and set values before running

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=academiciq
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=academiciq

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security — CHANGE IN PRODUCTION (openssl rand -hex 64)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# App
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# LLM (default: local Ollama)
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3

# Optional: external LLM
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Privacy
PRIVACY_REGULATION=DPDP
DATA_RETENTION_YEARS=7
